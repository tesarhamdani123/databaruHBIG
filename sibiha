<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover"
  />
  <meta name="theme-color" content="#0284C7" />
  <title>HBIG MONITORING</title>
  <style>
    :root {
      --bg: #EEF6FC;
      --primary: #0284C7;
      --primary-dark: #0369A1;
      --text: #0F172A;
      --muted: #64748B;
    }

    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    html,
    body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: var(--bg);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      color: var(--text);
    }

    .webview-wrapper {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      background: var(--bg);
    }

    #appsScriptFrame {
      width: 100%;
      height: 100%;
      border: 0;
      display: block;
      background: var(--bg);
    }

    .splash-overlay {
      position: fixed;
      inset: 0;
      z-index: 20;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 24px;
      text-align: center;
      background: linear-gradient(155deg, #0369A1 0%, #0284C7 60%, #38BDF8 100%);
      color: #FFFFFF;
      transition: opacity 0.25s ease, visibility 0.25s ease;
    }

    .splash-overlay.hidden {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    .spinner {
      width: 38px;
      height: 38px;
      border: 4px solid rgba(255, 255, 255, 0.28);
      border-top-color: #FFFFFF;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      margin-bottom: 14px;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .splash-title {
      font-size: 18px;
      font-weight: 800;
      margin: 0 0 6px;
      letter-spacing: 0.3px;
    }

    .splash-sub {
      font-size: 12px;
      opacity: 0.92;
      margin: 0 0 16px;
      max-width: 320px;
      line-height: 1.5;
    }

    .btn-retry {
      display: none;
      border: none;
      background: #FFFFFF;
      color: var(--primary-dark);
      font-weight: 800;
      font-size: 12px;
      padding: 10px 18px;
      border-radius: 10px;
      cursor: pointer;
      box-shadow: 0 6px 18px rgba(15, 23, 42, 0.2);
    }

    .btn-retry.show {
      display: inline-block;
    }

    .dl-toast {
      position: fixed;
      left: 50%;
      bottom: 20px;
      transform: translateX(-50%) translateY(20px);
      z-index: 30;
      background: #0F172A;
      color: #FFFFFF;
      font-size: 12px;
      font-weight: 700;
      padding: 10px 16px;
      border-radius: 999px;
      opacity: 0;
      pointer-events: none;
      transition: all 0.2s ease;
      max-width: 90vw;
      text-align: center;
    }

    .dl-toast.show {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }
  </style>
</head>
<body>
  <div id="splashOverlay" class="splash-overlay">
    <div class="spinner" aria-hidden="true"></div>
    <h1 class="splash-title">HBIG MONITORING</h1>
    <p id="splashStatus" class="splash-sub">Menghubungkan ke server aplikasi...</p>
    <button id="btnRetry" type="button" class="btn-retry" onclick="reloadAppFrame()">
      Muat Ulang
    </button>
  </div>

  <div class="webview-wrapper">
    <iframe
      id="appsScriptFrame"
      title="HBIG MONITORING"
      allow="camera; microphone; geolocation; clipboard-read; clipboard-write"
      referrerpolicy="no-referrer-when-downgrade"
    ></iframe>
  </div>

  <div id="dlToast" class="dl-toast"></div>

  <script>
    // GANTI URL DI BAWAH INI DENGAN URL DEPLOYMENT WEB APP GOOGLE APPS SCRIPT ANDA
    // Contoh: 'https://script.google.com/macros/s/AKfycbx.../exec'
    const APPS_SCRIPT_WEBAPP_URL = 'https://script.google.com/macros/s/AKfycbwj5x4wBc-_2RdB6prR3UD8tiHM24Lj5u0xcb6QNc3t60StIcaFCtR0zm7h0_T_XJfQsw/exec';

    const frameEl = document.getElementById('appsScriptFrame');
    const splashEl = document.getElementById('splashOverlay');
    const statusEl = document.getElementById('splashStatus');
    const retryEl = document.getElementById('btnRetry');
    const toastEl = document.getElementById('dlToast');

    let loadTimeout_ = null;
    let toastTimeout_ = null;

    function showNativeToast(msg) {
      if (!toastEl) return;
      toastEl.textContent = msg;
      toastEl.classList.add('show');
      if (toastTimeout_) clearTimeout(toastTimeout_);
      toastTimeout_ = setTimeout(() => toastEl.classList.remove('show'), 2800);
    }

    function hideSplash() {
      if (loadTimeout_) {
        clearTimeout(loadTimeout_);
        loadTimeout_ = null;
      }
      splashEl.classList.add('hidden');
      retryEl.classList.remove('show');
    }

    function showRetryError(msg) {
      statusEl.textContent = msg || 'Gagal memuat aplikasi. Periksa koneksi internet Anda.';
      retryEl.classList.add('show');
    }

    function isValidWebAppUrl(url) {
      return /^https:\/\/script\.google\.com\/macros\/s\/[^/]+\/exec/i.test(String(url || '').trim());
    }

    function reloadAppFrame() {
      if (!isValidWebAppUrl(APPS_SCRIPT_WEBAPP_URL)) {
        showRetryError('URL Google Apps Script belum diisi pada index.html GitHub.');
        return;
      }

      if (!navigator.onLine) {
        showRetryError('Tidak ada koneksi internet. Aktifkan Wi-Fi atau data seluler.');
        return;
      }

      retryEl.classList.remove('show');
      statusEl.textContent = 'Memuat HBIG MONITORING...';
      splashEl.classList.remove('hidden');

      if (loadTimeout_) clearTimeout(loadTimeout_);
      loadTimeout_ = setTimeout(() => {
        showRetryError('Waktu tunggu habis. Silakan coba muat ulang.');
      }, 15000);

      const sep = APPS_SCRIPT_WEBAPP_URL.indexOf('?') === -1 ? '?' : '&';
      frameEl.src = `${APPS_SCRIPT_WEBAPP_URL}${sep}_t=${Date.now()}`;
    }

    frameEl.addEventListener('load', () => {
      hideSplash();
    });

    frameEl.addEventListener('error', () => {
      showRetryError('Gagal membuka halaman aplikasi.');
    });

    window.addEventListener('online', () => {
      if (!splashEl.classList.contains('hidden')) {
        reloadAppFrame();
      }
    });

    // Terima data Excel/file base64 dari Apps Script (lihat postMessage HBIG_DOWNLOAD_BASE64)
    window.addEventListener('message', (event) => {
      const data = event && event.data;
      if (!data || data.type !== 'HBIG_DOWNLOAD_BASE64') return;

      const fileName = String(data.fileName || 'Data_Penerima_HBIG_dan_Pemantauan.xlsx');
      const mimeType = String(data.mimeType || 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet');
      const base64Data = String(data.base64Data || '');

      if (!base64Data) {
        showNativeToast('Data file kosong, gagal mengunduh.');
        return;
      }

      // 1. Jika dibungkus di Android Studio dengan @JavascriptInterface bernama "AndroidBridge"
      if (
        window.AndroidBridge &&
        typeof window.AndroidBridge.downloadBase64File === 'function'
      ) {
        try {
          window.AndroidBridge.downloadBase64File(base64Data, fileName, mimeType);
          showNativeToast('Mengunduh ' + fileName + ' ke folder Download...');
          return;
        } catch (_err) {}
      }

      // 2. Fallback browser / WebView standar menggunakan Blob
      try {
        const binaryStr = atob(base64Data);
        const bytes = new Uint8Array(binaryStr.length);
        for (let i = 0; i < binaryStr.length; i++) {
          bytes[i] = binaryStr.charCodeAt(i);
        }
        const blob = new Blob([bytes], { type: mimeType });
        const blobUrl = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = blobUrl;
        link.download = fileName;
        link.rel = 'noopener';
        document.body.appendChild(link);
        link.click();
        setTimeout(() => {
          document.body.removeChild(link);
          URL.revokeObjectURL(blobUrl);
        }, 1500);
        showNativeToast('File diunduh: ' + fileName);
      } catch (_e) {
        showNativeToast('Gagal memproses file unduhan.');
      }
    });

    window.addEventListener('DOMContentLoaded', reloadAppFrame);
  </script>
</body>
</html>

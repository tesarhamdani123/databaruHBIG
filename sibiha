<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>HBIG MONITORING — WebView Wrapper</title>
  <style>
    :root {
      --primary: #0284C7;
      --primary-dark: #0369A1;
      --bg: #EEF6FC;
      --surface: #FFFFFF;
      --text: #0F172A;
      --muted: #64748B;
      --danger: #DC2626;
      --success: #059669;
    }

    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: var(--bg);
      color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    .wrapper-root {
      position: relative;
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
    }

    #appsScriptFrame {
      width: 100%;
      height: 100%;
      flex: 1;
      border: none;
      display: block;
      background: var(--bg);
    }

    .loading-overlay {
      position: fixed;
      inset: 0;
      z-index: 30;
      background: linear-gradient(155deg, #0369A1 0%, #0284C7 60%, #38BDF8 100%);
      color: #FFFFFF;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 24px;
      text-align: center;
      transition: opacity 0.25s ease, visibility 0.25s ease;
    }

    .loading-overlay.hidden {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    .spinner {
      width: 42px;
      height: 42px;
      border: 4px solid rgba(255, 255, 255, 0.28);
      border-top-color: #FFFFFF;
      border-radius: 50%;
      animation: spin 0.85s linear infinite;
      margin-bottom: 14px;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .loading-title {
      font-size: 16px;
      font-weight: 800;
      margin: 0 0 6px;
    }

    .loading-sub {
      font-size: 12px;
      opacity: 0.92;
      max-width: 300px;
      line-height: 1.45;
      margin: 0 0 16px;
    }

    .btn-retry {
      border: 1px solid rgba(255, 255, 255, 0.55);
      background: rgba(255, 255, 255, 0.18);
      color: #FFFFFF;
      padding: 9px 16px;
      border-radius: 10px;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
    }

    .btn-retry:active {
      background: rgba(255, 255, 255, 0.3);
    }

    .wrapper-toast {
      position: fixed;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%) translateY(16px);
      z-index: 40;
      background: #0F172A;
      color: #FFFFFF;
      padding: 9px 16px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 700;
      opacity: 0;
      pointer-events: none;
      transition: all 0.2s ease;
      max-width: 90vw;
      text-align: center;
      box-shadow: 0 8px 24px rgba(15, 23, 42, 0.25);
    }

    .wrapper-toast.show {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }
  </style>
</head>
<body>
  <div class="wrapper-root">
    <div id="loadingOverlay" class="loading-overlay">
      <div class="spinner" aria-hidden="true"></div>
      <div class="loading-title">HBIG MONITORING</div>
      <p id="loadingSub" class="loading-sub">Menghubungkan ke server aplikasi...</p>
      <button type="button" id="retryBtn" class="btn-retry" style="display:none;" onclick="reloadIframe(true)">
        Muat Ulang Aplikasi
      </button>
    </div>

    <iframe
      id="appsScriptFrame"
      title="HBIG Monitoring Apps Script"
      allow="camera; microphone; geolocation; clipboard-read; clipboard-write"
      referrerpolicy="strict-origin-when-cross-origin"
    ></iframe>
  </div>

  <div id="wrapperToast" class="wrapper-toast"></div>

  <script>
    const APPS_SCRIPT_EXEC_URL = 'https://script.google.com/macros/s/AKfycbwj5x4wBc-_2RdB6prR3UD8tiHM24Lj5u0xcb6QNc3t60StIcaFCtR0zm7h0_T_XJfQsw/exec';
    const ALLOWED_ORIGINS = [
      'https://script.google.com',
      'https://script.googleusercontent.com'
    ];

    const iframeEl = document.getElementById('appsScriptFrame');
    const overlayEl = document.getElementById('loadingOverlay');
    const loadingSubEl = document.getElementById('loadingSub');
    const retryBtnEl = document.getElementById('retryBtn');
    const toastEl = document.getElementById('wrapperToast');

    let loadTimeoutId = null;
    let toastTimeoutId = null;

    function showWrapperToast(msg) {
      if (!toastEl) return;
      toastEl.textContent = msg;
      toastEl.classList.add('show');
      if (toastTimeoutId) clearTimeout(toastTimeoutId);
      toastTimeoutId = setTimeout(() => {
        toastEl.classList.remove('show');
      }, 2800);
    }

    function hideLoadingOverlay() {
      if (loadTimeoutId) {
        clearTimeout(loadTimeoutId);
        loadTimeoutId = null;
      }
      if (overlayEl) {
        overlayEl.classList.add('hidden');
      }
    }

    function showLoadingError(message) {
      if (!overlayEl) return;
      overlayEl.classList.remove('hidden');
      if (loadingSubEl) {
        loadingSubEl.textContent = message || 'Koneksi terganggu. Periksa jaringan internet Anda.';
      }
      if (retryBtnEl) {
        retryBtnEl.style.display = 'inline-block';
      }
    }

    function buildTargetUrl() {
      const url = new URL(APPS_SCRIPT_EXEC_URL);
      url.searchParams.set('_wv', 'android');
      url.searchParams.set('_ts', String(Date.now()));
      return url.toString();
    }

    function reloadIframe(forceFresh) {
      if (!iframeEl) return;
      if (retryBtnEl) retryBtnEl.style.display = 'none';
      if (loadingSubEl) loadingSubEl.textContent = 'Memuat aplikasi HBIG Monitoring...';
      if (overlayEl) overlayEl.classList.remove('hidden');

      if (loadTimeoutId) clearTimeout(loadTimeoutId);
      loadTimeoutId = setTimeout(() => {
        showLoadingError('Waktu muat habis. Coba muat ulang atau periksa koneksi internet.');
      }, 20000);

      iframeEl.src = forceFresh ? buildTargetUrl() : APPS_SCRIPT_EXEC_URL;
    }

    iframeEl.addEventListener('load', () => {
      hideLoadingOverlay();
    });

    iframeEl.addEventListener('error', () => {
      showLoadingError('Gagal memuat halaman Apps Script. Coba muat ulang.');
    });

    // Jembatan unduhan file (mis. Excel .xlsx / .csv) dari iframe ke Android WebView
    function forwardFileDownloadToAndroid(payload) {
      if (!payload || !payload.base64Data) return false;
      const fileName = String(payload.fileName || 'Data_Penerima_HBIG_dan_Pemantauan.xlsx');
      const mimeType = String(payload.mimeType || 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet');
      const base64Data = String(payload.base64Data);

      // 1. Jika Android menginjeksikan JavascriptInterface bernama "HBIGAndroid"
      if (window.HBIGAndroid && typeof window.HBIGAndroid.saveBase64File === 'function') {
        try {
          window.HBIGAndroid.saveBase64File(base64Data, fileName, mimeType);
          showWrapperToast('Mengunduh ' + fileName + ' ke penyimpanan HP...');
          return true;
        } catch (_err) {}
      }

      // 2. Jika Android menginjeksikan JavascriptInterface alternatif bernama "AndroidBridge"
      if (window.AndroidBridge && typeof window.AndroidBridge.downloadBase64File === 'function') {
        try {
          window.AndroidBridge.downloadBase64File(base64Data, fileName, mimeType);
          showWrapperToast('Mengunduh ' + fileName + ' ke penyimpanan HP...');
          return true;
        } catch (_err) {}
      }

      // 3. Fallback browser/WebView via data URL (lebih kompatibel di beberapa WebView dibanding blob:)
      try {
        const dataUrl = `data:${mimeType};base64,${base64Data}`;
        const link = document.createElement('a');
        link.href = dataUrl;
        link.download = fileName;
        link.rel = 'noopener';
        document.body.appendChild(link);
        link.click();
        setTimeout(() => {
          document.body.removeChild(link);
        }, 1200);
        return true;
      } catch (_err) {
        return false;
      }
    }

    window.addEventListener('message', (event) => {
      const origin = String(event.origin || '');
      const isAllowed = ALLOWED_ORIGINS.some(allowed => origin.indexOf(allowed) === 0) ||
        origin === window.location.origin;

      if (!isAllowed) return;
      const data = event.data;
      if (!data || typeof data !== 'object') return;

      if (data.type === 'HBIG_DOWNLOAD_BASE64') {
        forwardFileDownloadToAndroid(data);
      } else if (data.type === 'HBIG_TOAST' && data.message) {
        showWrapperToast(String(data.message));
      }
    });

    window.addEventListener('online', () => {
      if (overlayEl && !overlayEl.classList.contains('hidden')) {
        reloadIframe(true);
      }
    });

    window.addEventListener('DOMContentLoaded', () => {
      reloadIframe(true);
    });
  </script>
</body>
</html>
